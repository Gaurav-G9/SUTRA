# Sutra Configuration File
# Copy this file to .env and fill in your settings

# Application Settings
APP_NAME=Sutra
DEBUG=False
LOG_LEVEL=INFO
LANGUAGE=hi
TIMEZONE=Asia/Kolkata

# Database Configuration
DATABASE_URL=sqlite:///./sutra.db
# For PostgreSQL: postgresql://user:password@localhost/sutra
# For MySQL: mysql+pymysql://user:password@localhost/sutra

# File Paths
PDF_OUTPUT_DIR=./data/pdfs
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
LOG_DIR=./logs
CACHE_DIR=./cache

# Web Scraping Configuration
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
RATE_LIMIT_DELAY=2

# Scheduling
ENABLE_SCHEDULER=True
SCHEDULER_TIME=06:00
SCHEDULER_TIMEZONE=Asia/Kolkata

# Email Notifications
ENABLE_EMAIL_NOTIFICATION=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENTS=recipient@example.com

# PDF Generation
PDF_PAPER_SIZE=A4
PDF_MARGIN_TOP=10
PDF_MARGIN_BOTTOM=10
PDF_MARGIN_LEFT=10
PDF_MARGIN_RIGHT=10
PDF_FONT_SIZE=10
PDF_LINE_HEIGHT=1.5

# Content Configuration
MIN_CONTENT_LENGTH=100
MAX_CONTENT_LENGTH=5000
DEDUPLICATION_THRESHOLD=0.85
SUMMARY_LENGTH=150

# Proxy Settings (Optional)
ENABLE_PROXY=False
PROXY_URL=http://proxy-server:port

# API Keys (if needed)
NEWS_API_KEY=your-api-key
RAPID_API_KEY=your-api-key

# Performance
MAX_WORKERS=4
CACHE_EXPIRY_HOURS=24
DATABASE_POOL_SIZE=10

# Feature Flags
FEATURE_NLP_ANALYSIS=True
FEATURE_TREND_DETECTION=True
FEATURE_HISTORICAL_TRACKING=True
FEATURE_EMAIL_DELIVERY=False
FEATURE_WEB_DASHBOARD=False

# Logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/sutra.log
